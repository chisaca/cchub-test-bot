// services/hotrecharge-services/airtimezig.js
// ============================================================================
// HOTRECHARGE ZIG AIRTIME SERVICE
// Handles ZiG airtime purchases for all Zimbabwean mobile networks
// Product ID 110 works for ALL networks (Econet, NetOne, Telecel) in ZiG
// Amount range: 0.10 ZiG - 200,000 ZiG (in 0.01 ZiG increments)
// AccountTypeId: 1 (ZiG Airtime)
// 
// Dependencies: Requires initialization with shared HotRecharge functions
// ============================================================================

const constants = require('../../config/constants');
require('dotenv').config();
const axios = require('axios');

// ============================================================================
// DEPENDENCY INJECTION
// Shared functions from main hotrecharge.js - set via init()
// ============================================================================
let authenticate;              // Token authentication function
let getBalance;                // Balance check function
let generateAgentReference;    // Reference generator function

/**
 * Initialize the module with shared HotRecharge functions
 * Must be called before using purchaseAirtime()
 * 
 * @param {Object} deps - Dependencies from main hotrecharge.js
 * @param {Function} deps.authenticate - Token authentication function
 * @param {Function} deps.getBalance - Balance check function
 * @param {Function} deps.generateAgentReference - Reference generator
 */
function init(deps) {
    console.log('🔧 [ZiG AIRTIME] Initializing with dependencies');
    
    authenticate = deps.authenticate;
    getBalance = deps.getBalance;
    generateAgentReference = deps.generateAgentReference;
    
    // Verify successful initialization
    console.log('✅ [ZiG AIRTIME] Dependencies initialized:', {
        authenticate: typeof authenticate === 'function',
        getBalance: typeof getBalance === 'function',
        generateAgentReference: typeof generateAgentReference === 'function'
    });
}

// ============================================================================
// VALIDATION FUNCTIONS
// ============================================================================

/**
 * Validate ZiG amount against configured min/max and increment rules
 * ZiG amounts must be in 0.01 increments (2 decimal places)
 * 
 * @param {number} amount - Amount in ZiG to validate
 * @returns {Object} Validation result with valid flag and optional error
 */
function validateAmount(amount) {
    const min = constants.PAYMENT_CONFIG.MIN_AMOUNTS.AIRTIME_ZIG;
    const max = constants.PAYMENT_CONFIG.MAX_AMOUNTS.AIRTIME_ZIG;
    const increment = 0.01; // Fixed increment for ZiG (2 decimal places)
    
    // Check if amount is a valid number
    if (isNaN(amount) || amount === null || amount === undefined) {
        return {
            valid: false,
            error: `Please enter a valid amount`
        };
    }
    
    // Check range
    if (amount < min || amount > max) {
        return {
            valid: false,
            error: `Amount must be between ${min.toFixed(2)} ZiG and ${max.toLocaleString()} ZiG`
        };
    }
    
    // Check increment (must be to 2 decimal places)
    // Multiply by 100 to work with integers (10.50 → 1050)
    const scaledAmount = Math.round(amount * 100);
    if (scaledAmount % 1 !== 0) {
        return {
            valid: false,
            error: `Amount must be in 0.01 ZiG increments (e.g., 10.50, 25.75)`
        };
    }
    
    return { valid: true };
}

/**
 * Validate recipient phone number and detect network
 * Supports both local (077...) and international (26377...) formats
 * 
 * @param {string} phone - Phone number to validate
 * @returns {Object} Validation result with network detection
 */
function validateRecipient(phone) {
    const cleaned = phone.replace(/\D/g, '');
    
    // Regex: 10 digits starting with 07 OR 12 digits starting with 2637
    const isValid = /^(07[0-9]{8})$|^(2637[0-9]{8})$/.test(cleaned);
    
    if (!isValid) {
        return { 
            valid: false, 
            error: 'Invalid Zimbabwean phone number. Use format: 0771234567' 
        };
    }
    
    // Convert to local format for network detection
    const localNumber = cleaned.startsWith('263') ? '0' + cleaned.substring(3) : cleaned;
    const prefix = localNumber.substring(0, 3);
    
    // Detect network based on prefix
    let network = 'Unknown';
    if (prefix === '077' || prefix === '078') network = 'Econet';
    else if (prefix === '071') network = 'NetOne';
    else if (prefix === '073') network = 'Telecel';
    
    return {
        valid: true,
        network,
        localNumber,
        internationalNumber: '263' + localNumber.substring(1)
    };
}

/**
 * Format ZiG amount for display
 * 
 * @param {number} amount - Amount to format
 * @returns {string} Formatted amount with ZiG symbol
 */
function formatAmount(amount) {
    return `${amount.toFixed(2)} ZiG`;
}

// ============================================================================
// CORE PURCHASE FUNCTION
// ============================================================================

/**
 * Purchase ZiG airtime through HotRecharge
 * Includes balance check, retry logic, and comprehensive logging
 * 
 * @param {Object} params - Transaction parameters
 * @param {string} params.recipient - Recipient phone number
 * @param {number} params.amount - Amount in ZiG
 * @param {string} params.userId - User identifier for tracking
 * @param {string|null} params.customSms - Optional custom SMS message
 * @returns {Promise<Object>} Transaction result with success flag and details
 */
async function purchaseAirtime({ recipient, amount, userId = 'USER', customSms = null }) {
    console.log('💰 [ZiG AIRTIME] ==================== START ====================');
    console.log(`📱 [ZiG AIRTIME] Recipient: ${recipient.slice(0,5)}****${recipient.slice(-3)}`);
    console.log(`💰 [ZiG AIRTIME] Amount: ${formatAmount(amount)}`);

    // ========================================================================
    // STEP 1: Verify dependencies are initialized
    // ========================================================================
    if (typeof authenticate !== 'function') {
        console.error('❌ [ZiG AIRTIME] Service not initialized - authenticate missing');
        return {
            success: false,
            error: 'Service not properly initialized'
        };
    }
    
    if (typeof getBalance !== 'function') {
        console.error('❌ [ZiG AIRTIME] Service not initialized - getBalance missing');
        return {
            success: false,
            error: 'Service not properly initialized'
        };
    }
    
    if (typeof generateAgentReference !== 'function') {
        console.error('❌ [ZiG AIRTIME] Service not initialized - generateAgentReference missing');
        return {
            success: false,
            error: 'Service not properly initialized'
        };
    }
    
    const maxRetries = parseInt(process.env.HOT_MAX_RETRIES || '3');
    let lastError = null;

    // ========================================================================
    // STEP 2: Validate inputs
    // ========================================================================
    const amountValidation = validateAmount(amount);
    if (!amountValidation.valid) {
        console.error(`❌ [ZiG AIRTIME] Amount validation failed: ${amountValidation.error}`);
        return { success: false, error: amountValidation.error };
    }

    const recipientValidation = validateRecipient(recipient);
    if (!recipientValidation.valid) {
        console.error(`❌ [ZiG AIRTIME] Recipient validation failed: ${recipientValidation.error}`);
        return { success: false, error: recipientValidation.error };
    }

    console.log(`✅ [ZiG AIRTIME] Validation passed:`, {
        network: recipientValidation.network,
        amount: formatAmount(amount)
    });

    // ========================================================================
    // STEP 3: Check ZiG balance (AccountTypeId 1)
    // ========================================================================
    console.log(`💰 [ZiG AIRTIME] Checking ZiG balance...`);
    try {
        const balanceCheck = await getBalance(1);
        
        if (!balanceCheck.success) {
            console.warn('⚠️ [ZiG AIRTIME] Could not verify ZiG balance, proceeding anyway');
        } else {
            console.log(`💰 [ZiG AIRTIME] Current balance: ${formatAmount(balanceCheck.balance)}`);
            
            if (balanceCheck.balance < amount) {
                console.error(`❌ [ZiG AIRTIME] Insufficient balance: Need ${formatAmount(amount)}, have ${formatAmount(balanceCheck.balance)}`);
                return {
                    success: false,
                    error: `Insufficient ZiG balance. Available: ${formatAmount(balanceCheck.balance)}`
                };
            }
        }
    } catch (error) {
        console.warn('⚠️ [ZiG AIRTIME] Balance check failed:', error.message);
    }

    // ========================================================================
    // STEP 4: Determine product ID
    // Product ID 110 works for ALL networks in ZiG!
    // ========================================================================
    const productMap = {
        'Econet': 110,
        'NetOne': 110,
        'Telecel': 110
    };
    
    const productId = productMap[recipientValidation.network];
    console.log(`📦 [ZiG AIRTIME] Using Product ID: ${productId} for ${recipientValidation.network}`);
    
    if (!productId) {
        return {
            success: false,
            error: `${recipientValidation.network} ZiG airtime is currently unavailable. Please use USD instead.`
        };
    }

    // ========================================================================
    // STEP 5: Execute purchase with retry logic
    // ========================================================================
    for (let attempt = 1; attempt <= maxRetries; attempt++) {
        console.log(`🔄 [ZiG AIRTIME] Attempt ${attempt}/${maxRetries}`);
        
        try {
            // Get fresh token for each attempt
            const token = await authenticate();
            const agentReference = generateAgentReference(userId);
            console.log(`📋 [ZiG AIRTIME] Agent Reference: ${agentReference}`);

            // Build request body - using Product ID 110 (no ProductCode needed)
            const requestBody = {
                agentReference: agentReference,
                productId: productId,
                target: recipientValidation.localNumber,
                amount: amount
            };

            // Add SMS message (custom or default)
            if (customSms) {
                requestBody.CustomerSMS = customSms;
            } else {
                requestBody.CustomerSMS = `CCHub topped up your ${recipientValidation.network} account with ${formatAmount(amount)}. Thank you!`;
            }

            console.log('[ZiG AIRTIME] Request:', JSON.stringify({
                ...requestBody,
                target: '***' + requestBody.target.slice(-4) // Mask phone number
            }, null, 2));

            // Make API call to HotRecharge
            const response = await axios.post(
                `${process.env.HOT_API_BASE_URL}/products/recharge`,
                requestBody,
                {
                    headers: {
                        'Authorization': `Bearer ${token}`,
                        'Content-Type': 'application/json'
                    },
                    timeout: 30000 // 30 second timeout
                }
            );

            const result = response.data;

            // Check if transaction was successful
            if (result.successful) {
                console.log(`✅ [ZiG AIRTIME] Purchase successful!`);
                console.log(`   ├─ Recharge ID: ${result.rechargeId}`);
                console.log(`   ├─ Amount: ${formatAmount(result.amount)}`);
                console.log(`   ├─ Discount: ${formatAmount(result.discount || 0)}`);
                console.log(`   └─ New Balance: ${formatAmount(result.balance?.balance || 0)}`);

                return {
                    success: true,
                    service: 'airtime',
                    currency: 'ZiG',
                    transactionId: result.rechargeId,
                    amount: result.amount,
                    discount: result.discount || 0,
                    balance: result.balance?.balance,
                    recipient: recipientValidation.localNumber,
                    network: recipientValidation.network,
                    productId: productId,
                    agentReference: agentReference,
                    message: `✅ ${formatAmount(amount)} airtime for ${recipientValidation.network}`,
                    timestamp: new Date().toISOString()
                };
            } else {
                throw new Error(result.message || 'Transaction was not successful');
            }

        } catch (error) {
            console.error(`❌ [ZiG AIRTIME] Attempt ${attempt} failed:`, error.message);
            
            if (error.response) {
                console.error('📡 [ZiG AIRTIME] API Response:', JSON.stringify(error.response.data, null, 2));
            }
            
            lastError = error;
            
            // Don't retry on 400 (bad request) - it's likely a validation error
            if (error.response?.status === 400) {
                console.log('⛔ [ZiG AIRTIME] Bad request - not retrying');
                break;
            }
            
            // Exponential backoff before retry
            if (attempt < maxRetries) {
                const waitTime = Math.pow(2, attempt - 1) * 1000;
                console.log(`⏳ [ZiG AIRTIME] Retrying in ${waitTime}ms...`);
                await new Promise(resolve => setTimeout(resolve, waitTime));
            }
        }
    }

    // ========================================================================
    // STEP 6: All retries failed - format error message
    // ========================================================================
    let errorMessage = `ZiG airtime purchase failed after ${maxRetries} attempts.`;
    if (lastError) {
        if (lastError.response?.data?.title) {
            errorMessage = lastError.response.data.title;
        } else if (lastError.response?.data?.message) {
            errorMessage = lastError.response.data.message;
        } else if (lastError.message) {
            errorMessage = lastError.message;
        }
    }

    console.error(`❌ [ZiG AIRTIME] ${errorMessage}`);
    
    return {
        success: false,
        service: 'airtime',
        currency: 'ZiG',
        error: errorMessage,
        agentReference: generateAgentReference(userId)
    };
}

// ============================================================================
// EXPORTS
// ============================================================================
module.exports = {
    init,
    purchaseAirtime,
    validateAmount,
    validateRecipient,
    formatAmount
};
