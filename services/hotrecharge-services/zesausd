/**
 * USD ZESA Service Module
 * Handles USD ZESA electricity token purchases
 * Product ID: 41
 * Amount Range: $1 - $100 USD
 */

const axios = require('axios'); // ADDED: Missing import
const Joi = require('joi');

// Module state
let authenticate = null;
let getBalance = null;
let generateAgentReference = null;

// Meter number validation (11 digits)
const meterSchema = Joi.string().pattern(/^\d{11}$/).required();

// Amount validation schema
const amountSchema = Joi.number().min(1).max(100).precision(2).required();

// Phone number validation (Zimbabwe format) - IMPROVED REGEX
const phoneSchema = Joi.string().pattern(/^(\+?263|0)[0-9]{9}$/).required();

/**
 * Initialize module with dependencies
 */
function init(dependencies) {
    authenticate = dependencies.authenticate;
    getBalance = dependencies.getBalance;
    generateAgentReference = dependencies.generateAgentReference;
}

/**
 * Validate meter number format
 */
function validateMeter(meterNumber) {
    const { error } = meterSchema.validate(meterNumber);
    return {
        valid: !error,
        message: error ? 'Meter number must be 11 digits' : null
    };
}

/**
 * Validate amount
 */
function validateAmount(amount) {
    const { error } = amountSchema.validate(amount);
    if (error) return { valid: false, message: 'Amount must be between $1 and $100 USD' };
    return { valid: true };
}

/**
 * Validate phone number
 */
function validatePhone(phoneNumber, fieldName = 'Phone number') {
    const { error } = phoneSchema.validate(phoneNumber);
    return {
        valid: !error,
        message: error ? `${fieldName} must be a valid Zimbabwe number (e.g., 0771234567 or +263771234567)` : null
    };
}

/**
 * Format amount for display
 */
function formatAmount(amount) {
    return `$${amount.toFixed(2)} USD`;
}

