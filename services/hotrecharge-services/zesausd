// services/hotrecharge-services/zesausd.js
/**
 * HotRecharge USD ZESA Service
 * Handles USD ZESA prepaid token purchases
 * Product ID 41 for ZESA USD
 * Amount range: 1 USD - 100 USD (in 0.01 USD increments)
 * AccountTypeId: 4 (USD ZESA)
 * Requires: NotifyNumber for transaction notifications
 */

require('dotenv').config();
const axios = require('axios');

// Import shared utilities from parent (will be passed via dependency injection)
let authenticate;
let getBalance;
let generateAgentReference;

/**
 * Initialize the module with shared HotRecharge functions
 * @param {Object} deps - Dependencies from main hotrecharge.js
 */
function init(deps) {
    console.log('🔧 [ZESA USD] Initializing with dependencies:', {
        hasAuthenticate: !!deps.authenticate,
        hasGetBalance: !!deps.getBalance,
        hasGenerateAgentReference: !!deps.generateAgentReference
    });
    
    authenticate = deps.authenticate;
    getBalance = deps.getBalance;
    generateAgentReference = deps.generateAgentReference;
    
    console.log('✅ [ZESA USD] Dependencies set:', {
        authenticate: typeof authenticate,
        getBalance: typeof getBalance,
        generateAgentReference: typeof generateAgentReference
    });
}

/**
 * Validate USD ZESA amount
 * Based on metaData from API: MinimumRecharge: "1", MaxRecharge: "100"
 * @param {number} amount - Amount to validate
 * @returns {Object} Validation result
 */
function validateAmount(amount) {
    const min = 1;
    const max = 100;
    
    // Check if amount is a valid number
    if (isNaN(amount) || amount === null || amount === undefined) {
        return {
            valid: false,
            error: `Please enter a valid amount`
        };
    }
    
    // Check range
    if (amount < min || amount > max) {
        return {
            valid: false,
            error: `Amount must be between $${min.toFixed(2)} and $${max.toFixed(2)} USD`
        };
    }
    
    // Check increment (0.01 USD) - allow for floating point precision
    const remainder = (amount * 100) % 1;
    if (Math.abs(remainder) > 0.0001) {
        return {
            valid: false,
            error: `Amount must be in 0.01 USD increments (e.g., 5.50, 10.75)`
        };
    }
    
    return { valid: true };
}

/**
 * Validate ZESA meter number
 * @param {string} meterNumber - ZESA prepaid meter number
 * @returns {Object} Validation result
 */
function validateMeter(meterNumber) {
    const cleaned = meterNumber.replace(/\D/g, '');
    
    // ZESA meter numbers are 11 digits
    if (cleaned.length !== 11) {
        return {
            valid: false,
            error: 'ZESA meter number must be 11 digits'
        };
    }
    
    return {
        valid: true,
        meterNumber: cleaned
    };
}

/**
 * Format USD amount for display
 * @param {number} amount - Amount to format
 * @returns {string} Formatted amount with USD symbol
 */
function formatAmount(amount) {
    return `$${amount.toFixed(2)} USD`;
}

/**
 * Verify ZESA meter with HotRecharge
 * @param {string} meterNumber - ZESA meter number
 * @returns {Promise<Object>} Meter owner details
 */
async function verifyMeter(meterNumber) {
    console.log(`🔍 [ZESA USD] Verifying meter:`, meterNumber);
    
    try {
        const token = await authenticate();
        
        // Product ID 41 for USD ZESA
        const response = await axios.get(
            `${process.env.HOT_API_BASE_URL}/query/customer/41/${meterNumber}`,
            {
                headers: {
                    'Authorization': `Bearer ${token}`,
                    'Content-Type': 'application/json'
                },
                timeout: 10000
            }
        );

        console.log('✅ [ZESA USD] Meter verification response:', response.data);

        return {
            success: true,
            customerName: response.data.customerName || response.data.accountName || 'Registered customer',
            address: response.data.address,
            meterNumber: meterNumber
        };
        
    } catch (error) {
        console.error('❌ [ZESA USD] Meter verification failed:', error.response?.data || error.message);
        
        let errorMessage = 'Failed to verify meter number';
        if (error.response?.data?.title) {
            errorMessage = error.response.data.title;
        } else if (error.response?.data?.message) {
            errorMessage = error.response.data.message;
        }
        
        return {
            success: false,
            error: errorMessage
        };
    }
}

/**
 * Purchase USD ZESA token
 * @param {Object} params - Transaction parameters
 * @param {string} params.meterNumber - ZESA meter number
 * @param {number} params.amount - Amount in USD
 * @param {string} params.notifyNumber - Mobile number to receive notification
 * @param {string} params.userId - User identifier
 * @param {string} params.customSms - Optional custom SMS
 * @returns {Promise<Object>} Transaction result
 */
async function purchaseToken({ meterNumber, amount, notifyNumber, userId = 'USER', customSms = null }) {
    console.log('💰 [ZESA USD] ==================== START ====================');
    console.log(`📊 [ZESA USD] Params:`, { meterNumber, amount, notifyNumber, userId });
    
    // DEBUG: Check if dependencies are available
    console.log('🔍 [ZESA USD] Dependency check:', {
        authenticate: typeof authenticate,
        getBalance: typeof getBalance,
        generateAgentReference: typeof generateAgentReference
    });
    
    if (typeof authenticate !== 'function') {
        console.error('❌ [ZESA USD] authenticate is not a function!');
        return {
            success: false,
            error: 'Service not properly initialized - authenticate missing'
        };
    }
    
    if (typeof getBalance !== 'function') {
        console.error('❌ [ZESA USD] getBalance is not a function!');
        return {
            success: false,
            error: 'Service not properly initialized - getBalance missing'
        };
    }
    
    if (typeof generateAgentReference !== 'function') {
        console.error('❌ [ZESA USD] generateAgentReference is not a function!');
        return {
            success: false,
            error: 'Service not properly initialized - generateAgentReference missing'
        };
    }
    
    const maxRetries = parseInt(process.env.HOT_MAX_RETRIES || '3');
    let lastError = null;

    // Validate inputs
    const amountValidation = validateAmount(amount);
    if (!amountValidation.valid) {
        console.log(`❌ [ZESA USD] Amount validation failed:`, amountValidation.error);
        return { success: false, error: amountValidation.error };
    }

    const meterValidation = validateMeter(meterNumber);
    if (!meterValidation.valid) {
        console.log(`❌ [ZESA USD] Meter validation failed:`, meterValidation.error);
        return { success: false, error: meterValidation.error };
    }

    // Format notify number
    let formattedNotify = null;
    if (notifyNumber) {
        const cleaned = notifyNumber.replace(/\D/g, '');
        formattedNotify = cleaned.startsWith('263') ? '0' + cleaned.substring(3) : cleaned;
    }

    // 🔴 ADD DEBUG LOGS HERE
    console.log('📞 [ZESA USD] Original notifyNumber:', notifyNumber);
    console.log('📞 [ZESA USD] Formatted notifyNumber:', formattedNotify);
    console.log('📞 [ZESA USD] NotifyNumber type:', typeof formattedNotify);
    console.log('📞 [ZESA USD] NotifyNumber length:', formattedNotify?.length);
    console.log('📞 [ZESA USD] NotifyNumber exists?', !!formattedNotify);

    console.log(`✅ [ZESA USD] Validation passed:`, {
        meter: meterValidation.meterNumber,
        amount: amount,
        notifyNumber: formattedNotify
    });

    // Check USD ZESA balance (AccountTypeId 4)
    console.log(`💰 [ZESA USD] Checking balance for AccountTypeId 4...`);
    try {
        const balanceCheck = await getBalance(4);
        
        if (!balanceCheck.success) {
            console.warn('[ZESA USD] Could not verify USD ZESA balance, proceeding anyway');
        } else {
            console.log(`💰 [ZESA USD] Current balance: $${balanceCheck.balance.toFixed(2)}`);
            if (balanceCheck.balance < amount) {
                console.log(`❌ [ZESA USD] Insufficient balance: Need $${amount.toFixed(2)}, have $${balanceCheck.balance.toFixed(2)}`);
                return {
                    success: false,
                    error: `Insufficient USD ZESA balance. Available: $${balanceCheck.balance.toFixed(2)}`
                };
            }
        }
    } catch (error) {
        console.warn('[ZESA USD] Balance check failed:', error.message);
    }

    // Product ID 41 for ZESA USD
    const productId = 41;
    console.log(`📦 [ZESA USD] Using Product ID: ${productId}`);

    for (let attempt = 1; attempt <= maxRetries; attempt++) {
        console.log(`🔄 [ZESA USD] Attempt ${attempt}/${maxRetries}`);
        
        try {
            const token = await authenticate();
            console.log('🔑 [ZESA USD] Got token:', token ? 'Yes' : 'No');
            
            const agentReference = generateAgentReference(userId);
            console.log('📋 [ZESA USD] Agent Reference:', agentReference);

            // Build request body - NotifyNumber is required for ZESA
            const requestBody = {
                agentReference: agentReference,
                productId: productId,
                target: meterValidation.meterNumber,
                amount: amount,
                NotifyNumber: formattedNotify || '0771111111',  // EXACTLY this - capital N
                CustomerSMS: customSms || `CCHub: Your ZESA token purchase of $${amount.toFixed(2)} USD was successful. Thank you!`
            };

            // Add custom SMS if provided
            if (customSms) {
                requestBody.CustomerSMS = customSms;
            } else {
                requestBody.CustomerSMS = `CCHub: Your ZESA token purchase of $${amount.toFixed(2)} USD was successful. Thank you!`;
            }

            console.log('[ZESA USD] Request:', JSON.stringify({
                ...requestBody,
                target: '***' + requestBody.target.slice(-4),
                NotifyNumber: requestBody.NotifyNumber ? '***' + requestBody.NotifyNumber.slice(-4) : undefined
            }, null, 2));

            const response = await axios.post(
                `${process.env.HOT_API_BASE_URL}/products/recharge`,
                requestBody,
                {
                    headers: {
                        'Authorization': `Bearer ${token}`,
                        'Content-Type': 'application/json'
                    },
                    timeout: 30000
                }
            );

            const result = response.data;
            console.log('[ZESA USD] Response:', JSON.stringify(result, null, 2));

            if (result.successful) {
                // Extract token from response
                const token = result.token || result.voucher || result.voucherNumber || result.rechargeData?.token;
                const units = result.units || 'N/A';
                
                console.log(`✅ [ZESA USD] Purchase successful:`, {
                    rechargeId: result.rechargeId,
                    amount: result.amount,
                    token: token ? 'Yes' : 'No',
                    units: units,
                    newBalance: result.balance?.balance || 'N/A'
                });

                return {
                    success: true,
                    service: 'zesa',
                    currency: 'USD',
                    transactionId: result.rechargeId,
                    amount: result.amount,
                    token: token,
                    units: units,
                    discount: result.discount,
                    balance: result.balance?.balance,
                    meterNumber: meterValidation.meterNumber,
                    productId: productId,
                    agentReference: agentReference,
                    message: `✅ $${amount.toFixed(2)} USD ZESA token purchased`,
                    timestamp: new Date().toISOString()
                };
            } else {
                throw new Error(result.message || 'Transaction was not successful');
            }

        } catch (error) {
            console.log('❌ [ZESA USD] Attempt error:', error.message);
            
            if (error.response) {
                console.log('📡 [ZESA USD] Response status:', error.response.status);
                console.log('📡 [ZESA USD] Response data:', JSON.stringify(error.response.data, null, 2));
            }
            
            lastError = error;
            
            // Don't retry on 400 (bad request) - it's likely a validation error
            if (error.response?.status === 400) {
                console.log('❌ [ZESA USD] Bad request - not retrying');
                break;
            }
            
            // Don't retry on 409 (conflict) - duplicate transaction
            if (error.response?.status === 409) {
                console.log('❌ [ZESA USD] Duplicate transaction - not retrying');
                break;
            }
            
            if (attempt < maxRetries) {
                const waitTime = Math.pow(2, attempt - 1) * 1000;
                console.log(`[ZESA USD] Retrying in ${waitTime}ms...`);
                await new Promise(resolve => setTimeout(resolve, waitTime));
            }
        }
    }

    // Format error message
    let errorMessage = `ZESA token purchase failed after ${maxRetries} attempts.`;
    if (lastError) {
        if (lastError.response?.data?.title) {
            errorMessage = lastError.response.data.title;
        } else if (lastError.response?.data?.message) {
            errorMessage = lastError.response.data.message;
        } else if (lastError.message) {
            errorMessage = lastError.message;
        }
    }

    return {
        success: false,
        service: 'zesa',
        currency: 'USD',
        error: errorMessage,
        agentReference: generateAgentReference(userId)
    };
}

module.exports = {
    init,
    purchaseToken,
    validateAmount,
    validateMeter,
    verifyMeter,
    formatAmount
};