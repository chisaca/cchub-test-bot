/**
 * USD ZESA Service Module
 * Product ID: 41
 * Amount Range: $1 - $100 USD
 */

const axios = require('axios');
const Joi = require('joi');

// Module state
let authenticate = null;
let getBalance = null;
let generateAgentReference = null;

// Validation schemas
const meterSchema = Joi.string().pattern(/^\d{11}$/).required();
const amountSchema = Joi.number().min(1).max(100).precision(2).required();
const phoneSchema = Joi.string().pattern(/^(\+?263|0)[0-9]{9}$/).required();

function init(dependencies) {
    authenticate = dependencies.authenticate;
    getBalance = dependencies.getBalance;
    generateAgentReference = dependencies.generateAgentReference;
}

function validateMeter(meterNumber) {
    const { error } = meterSchema.validate(meterNumber);
    return {
        valid: !error,
        message: error ? 'Meter number must be 11 digits' : null
    };
}

function validateAmount(amount) {
    const { error } = amountSchema.validate(amount);
    if (error) return { valid: false, message: 'Amount must be between $1 and $100 USD' };
    return { valid: true };
}

function validatePhone(phoneNumber, fieldName = 'Phone number') {
    const { error } = phoneSchema.validate(phoneNumber);
    return {
        valid: !error,
        message: error ? `${fieldName} must be a valid Zimbabwe number (e.g., 0771234567 or +263771234567)` : null
    };
}

function formatAmount(amount) {
    return `$${amount.toFixed(2)} USD`;
}

function normalizePhone(phoneNumber) {
    if (!phoneNumber) return phoneNumber;
    // Remove all non-digits
    const digits = phoneNumber.replace(/\D/g, '');
    
    // Convert to 10-digit format without country code (077...)
    if (digits.length === 12 && digits.startsWith('263')) {
        return '0' + digits.substring(3);
    }
    if (digits.length === 10 && digits.startsWith('0')) {
        return digits;
    }
    if (digits.length === 9) {
        return '0' + digits;
    }
    // Return original if we can't normalize, let API handle it
    return phoneNumber;
}

async function verifyMeter(meterNumber) {
    console.log(`⚡ [ZESA-USD] Verifying meter: ${meterNumber}`);
    
    const formatCheck = validateMeter(meterNumber);
    if (!formatCheck.valid) {
        return { success: false, error: formatCheck.message };
    }

    try {
        const token = await authenticate();
        
        const response = await axios.get(
            `${process.env.HOT_API_BASE_URL}/query/customer/24/${meterNumber}`,
            {
                headers: {
                    'Authorization': `Bearer ${token}`,
                    'Content-Type': 'application/json'
                }
            }
        );

        console.log('[ZESA-USD] Verification response:', JSON.stringify(response.data, null, 2));

        if (response.data) {
            let customerName = 'Unknown';
            let address = 'N/A';
            
            if (response.data.details && response.data.details.AccountName) {
                const parts = response.data.details.AccountName.split('\n');
                customerName = parts[0].trim();
                if (parts.length > 1) address = parts.slice(1).join(' ').trim();
            }
            
            return {
                success: true,
                customerName: customerName,
                meterNumber: meterNumber,
                address: address,
                raw: response.data
            };
        }
        return { success: false, error: 'Meter number not found' };

    } catch (error) {
        console.error('[ZESA-USD] Verification failed:', error.response?.data || error.message);
        if (error.response?.status === 404) {
            return { success: false, error: 'Meter number not found in ZESA database' };
        }
        return { success: false, error: 'Failed to verify meter. Please try again.' };
    }
}

/**
 * FIXED: Proper RechargeOptions structure based on HotRecharge documentation
 * {
 *   "agentReference": "string",
 *   "productId": 41,
 *   "target": "string",
 *   "amount": 1.00,
 *   "RechargeOptions": [
 *     {
 *       "Name": "NotifyNumber",
 *       "ParameterType": "string", 
 *       "Value": "0772929223"
 *     }
 *   ]
 * }
 */
async function purchaseToken(params) {
    const { meterNumber, amount, notifyNumber, userId, paymentPhone } = params;
    
    console.log(`⚡ [ZESA-USD] Purchase request:`, { 
        meterNumber, 
        amount, 
        notifyNumber, 
        paymentPhone, 
        userId,
        timestamp: new Date().toISOString()
    });

    // Validate all inputs
    const meterCheck = validateMeter(meterNumber);
    if (!meterCheck.valid) return { success: false, error: meterCheck.message };

    const amountCheck = validateAmount(amount);
    if (!amountCheck.valid) return { success: false, error: amountCheck.message };

    const notifyCheck = validatePhone(notifyNumber, 'Notification number');
    if (!notifyCheck.valid) return { success: false, error: notifyCheck.message };

    if (paymentPhone) {
        const paymentCheck = validatePhone(paymentPhone, 'Payment phone number');
        if (!paymentCheck.valid) return { success: false, error: paymentCheck.message };
    }

    try {
        const token = await authenticate();
        
        // Check USD ZESA balance (AccountTypeId 4)
        const balanceCheck = await getBalance(4);
        if (!balanceCheck.success || balanceCheck.balance < amount) {
            return { 
                success: false, 
                error: `Insufficient USD ZESA balance. Available: $${balanceCheck.balance?.toFixed(2) || '0.00'}, Required: $${amount.toFixed(2)}` 
            };
        }

        // Generate a unique agent reference
        const agentReference = generateAgentReference(userId);
        
        // Normalize phone numbers - API expects local format (077...)
        const normalizedNotify = normalizePhone(notifyNumber);
        const normalizedPayment = paymentPhone ? normalizePhone(paymentPhone) : null;

        console.log(`[ZESA-USD] Normalized phone numbers:`, {
            original: notifyNumber,
            normalized: normalizedNotify,
            paymentOriginal: paymentPhone,
            paymentNormalized: normalizedPayment
        });

        // Construct the request EXACTLY as per documentation
        const rechargeRequest = {
            agentReference: agentReference,
            productId: 41,  // USD ZESA
            target: meterNumber,
            amount: amount,
            RechargeOptions: [
                {
                    Name: "NotifyNumber",
                    ParameterType: "string",
                    Value: normalizedNotify  // Format: 0775175454 (no country code)
                }
            ]
        };

        // Add optional fields if provided
        if (paymentPhone) {
            rechargeRequest.Notes = `Payment from: ${paymentPhone}`;
            rechargeRequest.CustomerReference = normalizedPayment;
        }

        // Optional: Add custom SMS template
        rechargeRequest.CustomSMS = "ZETDC token purchased for %ACOUNTNAME% (%METERNUMBER%) valued %AMOUNT%. %KWH% units.";

        console.log('[ZESA-USD] Sending request to HotRecharge:');
        console.log(JSON.stringify(rechargeRequest, null, 2));

        try {
            const response = await axios.post(
                `${process.env.HOT_API_BASE_URL}/products/recharge`,
                rechargeRequest,
                {
                    headers: {
                        'Authorization': `Bearer ${token}`,
                        'Content-Type': 'application/json'
                    },
                    timeout: 30000
                }
            );

            console.log('[ZESA-USD] HotRecharge Response:');
            console.log(JSON.stringify(response.data, null, 2));

            // Check for success based on response structure
            if (response.data) {
                // Different possible success indicators
                const isSuccess = response.data.Success === true || 
                                 response.data.Status === 'Success' || 
                                 response.data.Code === '0000' ||
                                 response.data.TransactionId;

                if (isSuccess) {
                    return {
                        success: true,
                        transactionId: response.data.TransactionId || response.data.Reference,
                        token: response.data.Token || response.data.Pin,
                        units: response.data.Units || response.data.Quantity,
                        amount: amount,
                        meterNumber: meterNumber,
                        notifyNumber: notifyNumber,
                        paymentPhone: paymentPhone,
                        customerName: response.data.CustomerName,
                        reference: agentReference,
                        message: `✅ ZESA token purchased successfully! Units: ${response.data.Units || response.data.Quantity || 'N/A'}`,
                        raw: response.data
                    };
                }
            }

            // If we get here, success wasn't indicated
            console.error('[ZESA-USD] Unexpected response structure:', response.data);
            return {
                success: false,
                error: 'Transaction completed but response format unexpected. Please check transaction status.',
                reference: agentReference,
                raw: response.data
            };

        } catch (error) {
            // Handle API errors
            console.error('[ZESA-USD] API Error:', {
                status: error.response?.status,
                statusText: error.response?.statusText,
                data: error.response?.data,
                message: error.message
            });

            // Parse error response
            if (error.response?.data) {
                const errorData = error.response.data;
                
                // Check if it's the NotifyNumber error
                if (errorData.errors && Array.isArray(errorData.errors)) {
                    const notifyError = errorData.errors.find(e => 
                        e.name === 'NotifyNumber' || 
                        e.field === 'NotifyNumber'
                    );
                    
                    if (notifyError) {
                        return {
                            success: false,
                            error: `Notification number error: ${notifyError.message || 'Invalid format'}`,
                            reference: agentReference,
                            details: notifyError
                        };
                    }
                }

                // Return formatted error
                return {
                    success: false,
                    error: errorData.Message || errorData.error || 'Transaction failed',
                    reference: agentReference,
                    details: errorData
                };
            }

            // Network or other errors
            return {
                success: false,
                error: 'Failed to connect to HotRecharge. Please try again.',
                reference: agentReference
            };
        }

    } catch (error) {
        console.error('[ZESA-USD] Critical error:', error);
        return {
            success: false,
            error: 'An unexpected error occurred. Please try again.'
        };
    }
}

/**
 * Query a transaction by agent reference
 */
async function queryTransaction(agentReference) {
    try {
        const token = await authenticate();
        const response = await axios.get(
            `${process.env.HOT_API_BASE_URL}/query/transaction/${agentReference}`,
            {
                headers: {
                    'Authorization': `Bearer ${token}`,
                    'Content-Type': 'application/json'
                }
            }
        );
        
        console.log(`[ZESA-USD] Transaction query for ${agentReference}:`, response.data);
        
        return { 
            success: true, 
            status: response.data.Status,
            transaction: response.data 
        };
    } catch (error) {
        console.error('[ZESA-USD] Transaction query failed:', error.message);
        return { 
            success: false, 
            error: 'Failed to query transaction' 
        };
    }
}

module.exports = {
    init,
    validateMeter,
    validateAmount,
    validatePhone,
    formatAmount,
    normalizePhone,
    verifyMeter,
    purchaseToken,
    queryTransaction
};