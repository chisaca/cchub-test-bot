/**
 * USD ZESA Service Module
 * Product ID: 41
 * Amount Range: $1 - $100 USD
 */

const axios = require('axios');
const Joi = require('joi');

// Module state
let authenticate = null;
let getBalance = null;
let generateAgentReference = null;

// Validation schemas
const meterSchema = Joi.string().pattern(/^\d{11}$/).required();
const amountSchema = Joi.number().min(1).max(100).precision(2).required();
const phoneSchema = Joi.string().pattern(/^(\+?263|0)[0-9]{9}$/).required();

function init(dependencies) {
    authenticate = dependencies.authenticate;
    getBalance = dependencies.getBalance;
    generateAgentReference = dependencies.generateAgentReference;
}

function validateMeter(meterNumber) {
    const { error } = meterSchema.validate(meterNumber);
    return {
        valid: !error,
        message: error ? 'Meter number must be 11 digits' : null
    };
}

function validateAmount(amount) {
    const { error } = amountSchema.validate(amount);
    if (error) return { valid: false, message: 'Amount must be between $1 and $100 USD' };
    return { valid: true };
}

function validatePhone(phoneNumber, fieldName = 'Phone number') {
    const { error } = phoneSchema.validate(phoneNumber);
    return {
        valid: !error,
        message: error ? `${fieldName} must be a valid Zimbabwe number (e.g., 0771234567 or +263771234567)` : null
    };
}

function formatAmount(amount) {
    return `$${amount.toFixed(2)} USD`;
}

function normalizePhone(phoneNumber) {
    if (!phoneNumber) return phoneNumber;
    const digits = phoneNumber.replace(/\D/g, '');
    if (digits.length === 10 && digits.startsWith('0')) return '263' + digits.substring(1);
    if (digits.length === 12 && digits.startsWith('263')) return digits;
    if (digits.length === 9) return '263' + digits;
    return phoneNumber;
}

async function verifyMeter(meterNumber) {
    console.log(`⚡ [ZESA-USD] Verifying meter: ${meterNumber}`);
    
    const formatCheck = validateMeter(meterNumber);
    if (!formatCheck.valid) {
        return { success: false, error: formatCheck.message };
    }

    try {
        const token = await authenticate();
        
        const response = await axios.get(
            `${process.env.HOT_API_BASE_URL}/query/customer/24/${meterNumber}`,
            {
                headers: {
                    'Authorization': `Bearer ${token}`,
                    'Content-Type': 'application/json'
                }
            }
        );

        console.log('[ZESA-USD] Verification response:', JSON.stringify(response.data, null, 2));

        if (response.data) {
            let customerName = 'Unknown';
            let address = 'N/A';
            
            if (response.data.details && response.data.details.AccountName) {
                const parts = response.data.details.AccountName.split('\n');
                customerName = parts[0].trim();
                if (parts.length > 1) address = parts.slice(1).join(' ').trim();
            }
            
            return {
                success: true,
                customerName: customerName,
                meterNumber: meterNumber,
                address: address,
                raw: response.data
            };
        }
        return { success: false, error: 'Meter number not found' };

    } catch (error) {
        console.error('[ZESA-USD] Verification failed:', error.response?.data || error.message);
        if (error.response?.status === 404) {
            return { success: false, error: 'Meter number not found in ZESA database' };
        }
        return { success: false, error: 'Failed to verify meter. Please try again.' };
    }
}

async function purchaseToken(params) {
    const { meterNumber, amount, notifyNumber, userId, paymentPhone } = params;
    
    console.log(`⚡ [ZESA-USD] Purchase request:`, { meterNumber, amount, notifyNumber, paymentPhone, userId });

    // Validate all inputs
    const meterCheck = validateMeter(meterNumber);
    if (!meterCheck.valid) return { success: false, error: meterCheck.message };

    const amountCheck = validateAmount(amount);
    if (!amountCheck.valid) return { success: false, error: amountCheck.message };

    const notifyCheck = validatePhone(notifyNumber, 'Notification number');
    if (!notifyCheck.valid) return { success: false, error: notifyCheck.message };

    if (paymentPhone) {
        const paymentCheck = validatePhone(paymentPhone, 'Payment phone number');
        if (!paymentCheck.valid) return { success: false, error: paymentCheck.message };
    }

    try {
        const token = await authenticate();
        
        const balanceCheck = await getBalance(4);
        if (!balanceCheck.success || balanceCheck.balance < amount) {
            return { success: false, error: 'Insufficient USD ZESA balance. Please fund your wallet.' };
        }

        // Try different phone formats with fresh agent reference each time
        const digits = notifyNumber.replace(/\D/g, '');
        const phoneFormats = [
            notifyNumber,                          // Original: 0775175454
            '0' + digits.slice(-9),                // Ensure 0 format: 0775175454
            '263' + digits.slice(-9),               // International: 263775175454
            digits,                                 // Just digits: 0775175454
        ];
        
        const uniqueFormats = [...new Set(phoneFormats)];
        console.log(`[ZESA-USD] Trying phone formats:`, uniqueFormats);

        for (const testNumber of uniqueFormats) {
            const freshRef = generateAgentReference(userId);
            
            console.log(`\n[ZESA-USD] Attempt with format: ${testNumber}, ref: ${freshRef}`);
            
            const rechargeRequest = {
                ProductId: 41,
                Amount: amount,
                Target: meterNumber,
                NotifyNumber: testNumber,
                AgentReference: freshRef
            };

            if (paymentPhone) {
                rechargeRequest.Notes = `Payment from: ${paymentPhone}`;
                rechargeRequest.CustomerReference = paymentPhone.replace(/\D/g, '');
            }

            console.log('[ZESA-USD] Request:', JSON.stringify(rechargeRequest, null, 2));

            try {
                const response = await axios.post(
                    `${process.env.HOT_API_BASE_URL}/products/recharge`,
                    rechargeRequest,
                    {
                        headers: {
                            'Authorization': `Bearer ${token}`,
                            'Content-Type': 'application/json'
                        },
                        timeout: 30000
                    }
                );

                console.log('[ZESA-USD] Response:', JSON.stringify(response.data, null, 2));

                if (response.data && response.data.Success) {
                    return {
                        success: true,
                        transactionId: response.data.TransactionId || response.data.Reference,
                        token: response.data.Token || response.data.Pin,
                        units: response.data.Units,
                        amount: amount,
                        meterNumber: meterNumber,
                        notifyNumber: notifyNumber,
                        paymentPhone: paymentPhone,
                        customerName: response.data.CustomerName,
                        reference: freshRef,
                        message: `✅ ZESA token purchased successfully! Units: ${response.data.Units || 'N/A'}`
                    };
                }
            } catch (error) {
                console.log(`[ZESA-USD] Failed with format ${testNumber}:`, error.response?.data || error.message);
                
                // If we get any error other than Duplicate AgentReference, log it and continue
                if (error.response?.data?.Errors) {
                    const errors = error.response.data.Errors;
                    if (errors.some(e => e.Name === 'Duplicate AgentReference')) {
                        console.log(`[ZESA-USD] Duplicate reference, trying next format...`);
                        continue;
                    }
                }
            }
        }

        return {
            success: false,
            error: 'Transaction failed after trying multiple formats. Please try again.',
            reference: generateAgentReference(userId)
        };

    } catch (error) {
        console.error('[ZESA-USD] Purchase failed:', error);
        return {
            success: false,
            error: 'An unexpected error occurred. Please try again.'
        };
    }
}

async function queryTransaction(agentReference) {
    try {
        const token = await authenticate();
        const response = await axios.get(
            `${process.env.HOT_API_BASE_URL}/query/transaction/${agentReference}`,
            {
                headers: {
                    'Authorization': `Bearer ${token}`,
                    'Content-Type': 'application/json'
                }
            }
        );
        return { success: true, status: response.data.Status, transaction: response.data };
    } catch (error) {
        console.error('[ZESA-USD] Transaction query failed:', error.message);
        return { success: false, error: 'Failed to query transaction' };
    }
}

module.exports = {
    init,
    validateMeter,
    validateAmount,
    validatePhone,
    formatAmount,
    verifyMeter,
    purchaseToken,
    queryTransaction
};