// services/hotrecharge-services/telonezig.js
// TelOne ZiG Bundle Purchases (Product IDs: 30, 31, 32, 33)

const axios = require('axios');
const { HOTRECHARGE_CONFIG } = require('../../config/constants');

class TelOneZiGService {
    constructor(tokenManager) {
        this.tokenManager = tokenManager;
        this.baseURL = process.env.HOT_API_BASE_URL || 'https://ssl.hot.co.zw/api/v3';
        this.accountTypeId = 1;
        this.serviceName = 'TelOne ZiG';

        this.PRODUCTS = {
            VOICE: 30,
            BROADBAND: 31,
            LTE: 32,
            VOIP: 33
        };

        this.PRODUCT_NAMES = {
            30: 'Voice',
            31: 'Broadband',
            32: 'LTE',
            33: 'VoIP'
        };

        // Cache for available bundles
        this.bundleCache = {};
        this.cacheExpiry = {};
    }

    async getToken() {
        try {
            return await this.tokenManager.getToken(this.serviceName);
        } catch (error) {
            console.error('[TelOneZiG] Token acquisition error:', error.message);
            throw new Error('Failed to get authentication token');
        }
    }

    validateAccount(accountNumber) {
        return /^\d{8}$/.test(accountNumber);
    }

    validateProductId(productId) {
        return Object.values(this.PRODUCTS).includes(productId);
    }

    /**
     * Get available bundles for a TelOne product
     */
    async getAvailableBundles(productId) {
        // Check cache first (5 minute cache)
        const cacheKey = `bundles_${productId}`;
        if (this.bundleCache[cacheKey] && this.cacheExpiry[cacheKey] > Date.now()) {
            console.log(`[TelOneZiG] Using cached bundles for product ${productId}`);
            return this.bundleCache[cacheKey];
        }

        try {
            const token = await this.getToken();
            
            console.log(`[TelOneZiG] Fetching available bundles for product ${productId}`);
            
            const response = await axios.get(
                `${this.baseURL}/stock/available/${productId}`,
                {
                    headers: {
                        'Authorization': `Bearer ${token}`,
                        'Content-Type': 'application/json'
                    },
                    timeout: 10000
                }
            );

            console.log(`[TelOneZiG] Bundles response:`, JSON.stringify(response.data, null, 2));

            let bundles = [];
            
            // Handle different response formats
            if (response.data && response.data.stock) {
                bundles = response.data.stock;
            } else if (Array.isArray(response.data)) {
                bundles = response.data;
            } else if (response.data && response.data.data) {
                bundles = response.data.data;
            }

            // Cache the results
            this.bundleCache[cacheKey] = bundles;
            this.cacheExpiry[cacheKey] = Date.now() + (5 * 60 * 1000); // 5 minutes

            return bundles;

        } catch (error) {
            console.error('[TelOneZiG] Error fetching bundles:', error.response?.data || error.message);
            
            // Return empty array on error
            return [];
        }
    }

    /**
     * Find the correct ProductCode for a given amount
     */
    async findProductCodeForAmount(productId, amount) {
        const bundles = await this.getAvailableBundles(productId);
        
        if (!bundles || bundles.length === 0) {
            console.log(`[TelOneZiG] No bundles available for product ${productId}`);
            return null;
        }

        console.log(`[TelOneZiG] Searching for amount ${amount} in bundles:`, bundles);

        // Try to find exact match
        for (const bundle of bundles) {
            const bundleAmount = bundle.amount || bundle.value || bundle.denomination;
            const productCode = bundle.productCode || bundle.code || bundle.id;
            
            if (bundleAmount && Math.abs(bundleAmount - amount) < 0.01) {
                console.log(`[TelOneZiG] Found exact match: ProductCode ${productCode} for amount ${amount}`);
                return productCode;
            }
        }

        // If no exact match, find closest
        let closestBundle = null;
        let smallestDiff = Infinity;

        for (const bundle of bundles) {
            const bundleAmount = bundle.amount || bundle.value || bundle.denomination;
            if (bundleAmount) {
                const diff = Math.abs(bundleAmount - amount);
                if (diff < smallestDiff) {
                    smallestDiff = diff;
                    closestBundle = bundle;
                }
            }
        }

        if (closestBundle) {
            const productCode = closestBundle.productCode || closestBundle.code || closestBundle.id;
            const bundleAmount = closestBundle.amount || closestBundle.value || closestBundle.denomination;
            console.log(`[TelOneZiG] Found closest match: ProductCode ${productCode} for amount ${bundleAmount} (requested: ${amount})`);
            return productCode;
        }

        return null;
    }

    /**
     * Purchase TelOne bundle
     */
    async purchase({ accountNumber, productId, amount, notifyNumber, reference }) {
        try {
            // Validate inputs
            if (!this.validateAccount(accountNumber)) {
                return {
                    success: false,
                    error: 'Invalid TelOne account number format. Must be 8 digits.'
                };
            }
            if (!this.validateProductId(productId)) {
                return {
                    success: false,
                    error: `Invalid TelOne product ID. Must be one of: ${Object.values(this.PRODUCTS).join(', ')}`
                };
            }

            const token = await this.getToken();

            // Format notify number
            const normalizedNotify = notifyNumber.startsWith('263')
                ? '0' + notifyNumber.substring(3)
                : notifyNumber;

            // Generate reference
            const agentReference = reference || `TEL${Date.now()}${Math.floor(Math.random() * 1000)}`;

            // Get the correct ProductCode for this amount
            const productCode = await this.findProductCodeForAmount(productId, amount);
            
            if (!productCode) {
                // If no bundles found, try to get list for error message
                const bundles = await this.getAvailableBundles(productId);
                let availableAmounts = 'No bundles available';
                
                if (bundles && bundles.length > 0) {
                    const amounts = bundles.map(b => b.amount || b.value || b.denomination).filter(a => a);
                    if (amounts.length > 0) {
                        availableAmounts = `Available amounts: ${amounts.join(', ')}`;
                    }
                }

                return {
                    success: false,
                    error: `No bundle found for amount ${amount}. ${availableAmounts}`,
                    retryable: false
                };
            }

            // Build request according to API docs
            const rechargeRequest = {
                agentReference: agentReference,
                productId: productId,
                ProductCode: parseInt(productCode), // Ensure it's an integer
                target: accountNumber,
                amount: amount,
                RechargeOptions: [
                    {
                        Name: "NotifyNumber",
                        ParameterType: "string",
                        Value: normalizedNotify
                    }
                ]
            };

            console.log('[TelOneZiG] Sending request:', JSON.stringify(rechargeRequest, null, 2));

            const response = await axios.post(
                `${this.baseURL}/products/recharge`,
                rechargeRequest,
                {
                    headers: {
                        'Authorization': `Bearer ${token}`,
                        'Content-Type': 'application/json'
                    },
                    timeout: 30000
                }
            );

            console.log('[TelOneZiG] Response:', JSON.stringify(response.data, null, 2));

            // Check success
            if (response.data) {
                const isSuccess = response.data.successful === true ||
                                 response.data.Success === true ||
                                 response.data.status === 'Success' ||
                                 response.data.Status === 'Success';

                if (isSuccess) {
                    return {
                        success: true,
                        transactionId: response.data.rechargeId || response.data.TransactionId,
                        reference: agentReference,
                        amount: amount,
                        accountNumber: accountNumber,
                        productId: productId,
                        productName: this.getProductName(productId),
                        raw: response.data
                    };
                }
            }

            return {
                success: false,
                error: response.data?.message || 'Transaction failed',
                reference: agentReference
            };

        } catch (error) {
            console.error('[TelOneZiG] API Error:', error.response?.data || error.message);

            if (error.response) {
                const { status, data } = error.response;
                
                if (data && data.errors) {
                    const errorMessages = Object.values(data.errors).flat().join(', ');
                    return {
                        success: false,
                        error: errorMessages || data.title || 'Validation error',
                        retryable: false
                    };
                }

                switch (status) {
                    case 400:
                        return {
                            success: false,
                            error: data?.title || data?.message || 'Invalid request.',
                            retryable: false
                        };
                    case 401:
                        return {
                            success: false,
                            error: 'Authentication failed. Please try again.',
                            retryable: true
                        };
                    case 403:
                        return {
                            success: false,
                            error: 'Insufficient balance for this transaction.',
                            retryable: false
                        };
                    case 404:
                        return {
                            success: false,
                            error: 'TelOne service temporarily unavailable.',
                            retryable: true
                        };
                    default:
                        return {
                            success: false,
                            error: data?.message || `Error ${status}`,
                            retryable: status >= 500
                        };
                }
            }

            return {
                success: false,
                error: error.message || 'Network error',
                retryable: true
            };
        }
    }

    getProductName(productId) {
        return this.PRODUCT_NAMES[productId] || 'Unknown';
    }

    async checkBalance() {
        try {
            const token = await this.getToken();
            const response = await axios.get(
                `${this.baseURL}/balance/accounttype/${this.accountTypeId}`,
                {
                    headers: {
                        'Authorization': `Bearer ${token}`,
                        'Content-Type': 'application/json'
                    },
                    timeout: HOTRECHARGE_CONFIG.REQUEST_TIMEOUT
                }
            );

            if (response.data) {
                const balance = response.data.balance ||
                              response.data.availableBalance ||
                              response.data.amount ||
                              0;
                return {
                    success: true,
                    balance: parseFloat(balance),
                    currency: 'ZiG',
                    accountType: this.accountTypeId
                };
            }

            return {
                success: false,
                error: 'Failed to fetch balance',
                balance: 0
            };
        } catch (error) {
            console.error('[TelOneZiG] Balance check error:', error.message);
            return {
                success: false,
                error: error.message,
                balance: 0
            };
        }
    }
}

module.exports = TelOneZiGService;
