/**
 * Diagnostic method to check available stock/bundles and all products
 * This will log ALL products in your account when called
 */
async diagnoseStock(productId) {
    try {
        console.log('\n' + '='.repeat(80));
        console.log('🔍 TELONE COMPLETE DIAGNOSTIC');
        console.log('='.repeat(80));
        
        const token = await this.getToken();
        
        // ============================================
        // STEP 1: Get ALL products (using product ID 0)
        // ============================================
        console.log('\n📋 STEP 1: FETCHING ALL PRODUCTS (ID: 0)');
        console.log('-'.repeat(50));
        
        try {
            const allProductsUrl = `${this.baseURL}/products/0`;
            console.log(`🔗 Trying: ${allProductsUrl}`);
            
            const allProductsResponse = await axios.get(allProductsUrl, {
                headers: {
                    'Authorization': `Bearer ${token}`,
                    'Content-Type': 'application/json'
                },
                timeout: 10000
            });
            
            console.log(`✅ Status: ${allProductsResponse.status}`);
            console.log('\n📊 ALL PRODUCTS IN YOUR ACCOUNT:');
            console.log(JSON.stringify(allProductsResponse.data, null, 2));
            
            // Parse and display products in a readable format
            if (allProductsResponse.data && allProductsResponse.data.products) {
                console.log('\n📋 PRODUCT LIST:');
                allProductsResponse.data.products.forEach(product => {
                    console.log(`\n🔹 Product ID: ${product.productId}`);
                    console.log(`   Name: ${product.name}`);
                    console.log(`   Account Type: ${product.accountTypeId}`);
                    console.log(`   Required Options: ${product.requiredOptions?.map(opt => opt.name).join(', ') || 'None'}`);
                    
                    if (product.metaData) {
                        console.log(`   Metadata:`, product.metaData);
                    }
                });
            }
            
        } catch (error) {
            console.log(`❌ Failed to fetch all products:`, error.response?.data || error.message);
        }
        
        // ============================================
        // STEP 2: Check specific product details
        // ============================================
        console.log('\n📋 STEP 2: CHECKING SPECIFIC PRODUCT DETAILS');
        console.log('-'.repeat(50));
        
        const productIds = [30, 31, 32, 33, 40, 15, 24, 41];
        
        for (const pid of productIds) {
            try {
                const productUrl = `${this.baseURL}/products/${pid}`;
                console.log(`\n🔗 Fetching product ${pid}...`);
                
                const response = await axios.get(productUrl, {
                    headers: {
                        'Authorization': `Bearer ${token}`,
                        'Content-Type': 'application/json'
                    },
                    timeout: 5000
                });
                
                console.log(`✅ Product ${pid}:`);
                console.log(JSON.stringify(response.data, null, 2));
                
            } catch (error) {
                if (error.response?.status === 404) {
                    console.log(`❌ Product ${pid} not found in your account`);
                } else {
                    console.log(`❌ Error fetching product ${pid}:`, error.message);
                }
            }
        }
        
        // ============================================
        // STEP 3: Check stock for TelOne products
        // ============================================
        console.log('\n📋 STEP 3: CHECKING STOCK FOR TELONE PRODUCTS');
        console.log('-'.repeat(50));
        
        const teloneIds = [30, 31, 32, 33, 40];
        
        for (const pid of teloneIds) {
            console.log(`\n📦 Checking stock for Product ID: ${pid} (${this.getProductName(pid)})`);
            
            const stockEndpoints = [
                `/query/stock/${pid}`,
                `/stock/available/${pid}`,
                `/products/stock/${pid}`,
                `/bundles/${pid}`
            ];
            
            for (const endpoint of stockEndpoints) {
                try {
                    const url = `${this.baseURL}${endpoint}`;
                    console.log(`  🔗 Trying: ${endpoint}`);
                    
                    const response = await axios.get(url, {
                        headers: {
                            'Authorization': `Bearer ${token}`,
                            'Content-Type': 'application/json'
                        },
                        timeout: 5000
                    });
                    
                    console.log(`  ✅ Status: ${response.status}`);
                    
                    if (response.data) {
                        console.log('  📊 Response:', JSON.stringify(response.data, null, 2));
                        
                        // Parse and display bundles if any
                        let bundles = [];
                        if (response.data.stock && Array.isArray(response.data.stock)) {
                            bundles = response.data.stock;
                        } else if (Array.isArray(response.data)) {
                            bundles = response.data;
                        }
                        
                        if (bundles.length > 0) {
                            console.log(`\n  ✅ Found ${bundles.length} bundles:`);
                            bundles.forEach((bundle, idx) => {
                                const code = bundle.productCode || bundle.code || bundle.id;
                                const amount = bundle.amount || bundle.value || bundle.denomination;
                                console.log(`     Bundle ${idx + 1}: Code=${code}, Amount=${amount}`);
                            });
                        }
                    }
                    
                } catch (error) {
                    if (error.response) {
                        console.log(`  ❌ Status: ${error.response.status}`);
                    } else {
                        console.log(`  ❌ Error: ${error.message}`);
                    }
                }
            }
        }
        
        console.log('\n' + '='.repeat(80));
        console.log('✅ DIAGNOSTIC COMPLETE');
        console.log('='.repeat(80));
        
    } catch (error) {
        console.error('❌ Diagnostic failed:', error.message);
    }
}
